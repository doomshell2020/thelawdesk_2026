# BEGIN Doomshell-Hardening
Options -Indexes
<FilesMatch "^(wp-config\.php|wp-config-sample\.php|readme\.html|license\.txt|xmlrpc\.php|error_log|debug\.log|\.user\.ini)$">
Require all denied
</FilesMatch>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
# END Doomshell-Hardening


# BEGIN LSCACHE
# END LSCACHE
# BEGIN NON_LSCACHE
# END NON_LSCACHE

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress

# ======================
# BASIC SECURITY (SAFE)
# ======================

# Disable directory listing
Options -Indexes

# Protect wp-config.php
<Files wp-config.php>
Require all denied
</Files>

# Block readme and license files
<FilesMatch "(readme\.html|license\.txt)">
Require all denied
</FilesMatch>

# Block XML-RPC (ONLY if not used)
<Files xmlrpc.php>
Require all denied
</Files>

# Security headers
<IfModule mod_headers.c>
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# GZIP compression
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript
</IfModule>
