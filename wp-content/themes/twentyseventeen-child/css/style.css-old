   width:auto;
   height:57px!important
}
.recomded_scroll2{
   width:50%;
   overflow-x:scroll;
   margin:auto;
   position:relative
}
.recomded_scroll2{
   margin-top:-100px
}
.recomded_scroll2 .trigger{
   width:50%;
   display:inline-block;
   height:100px;
   background-color:#000;
   float:left;
   visibility:hidden
}
#recommonde_sec .recomded_scroll2 .recommonded_inner2{
   width:200%
}
#recommonde_sec .owl-theme .owl-nav.disabled+.owl-dots{
   margin-top:60px
}
#recommonde_sec .owl-theme .owl-dots .owl-dot span{
   background-color:#dadada;
   width:120px;
   height:9px;
   margin:0;
   -webkit-border-radius:0;
   -moz-border-radius:0;
   border-radius:0
}
#recommonde_sec .owl-theme .owl-dots .owl-dot:first-child span{
   -webkit-border-radius:5px 0 0 5px;
   -moz-border-radius:5px 0 0 5px;
   border-radius:5px 0 0 5px
}
#recommonde_sec .owl-theme .owl-dots .owl-dot:last-child span{
   -webkit-border-radius:0 5px 5px 0;
   -moz-border-radius:0 5px 5px 0;
   border-radius:0 5px 5px 0
}
#recommonde_sec .owl-theme .owl-dots .owl-dot.active span,#recommonde_sec .owl-theme .owl-dots .owl-dot:hover span{
   background-color:#797979
}
.recomded_scroll2::-webkit-scrollbar{
   height:10px
}
.recomded_scroll2::-webkit-scrollbar-track{
   -webkit-box-shadow:inset 0 0 6px rgba(0,0,0,.3);
   width:500px
}
.recomded_scroll2::-webkit-scrollbar-thumb{
   background-color:#000;
   outline:1px solid #708090;
   width:500px
}
#contact_sec{
   padding:0 0
}
#contact_sec .mheading{
   text-transform:capitalize
}
#contact_sec form input{
   height:39px;
   border:none;
   border-bottom:1px solid #ccc;
   -webkit-border-radius:0;
   -moz-border-radius:0;
   border-radius:0
}
.entry-header h1.entry-title{
   font-size:40px!important;
   text-transform:capitalize!important
}
#contact_sec form input[type=submit]{
   color:#fff;
   text-align:center;
   font-size:16px;
   font-weight:700;
   width:120px;
   background:#000!important;
   -webkit-border-radius:6px;
   -moz-border-radius:6px;
   border-radius:6px
}
#contact_sec form textarea{
   border:none;
   border-bottom:1px solid #ccc;
   resize:none;
   height:120px;
   padding:10px
}
.f-style{
   position:relative
}
.f-style input,.f-style textarea{
   transition:.1s all linear
}
.form-group-lg .f-style textarea.form-control{
   padding-bottom:4.5rem
}
.f-style label{
   position:absolute;
   top:15px;
   left:30px;
   font-weight:300;
   transition:.1s all linear;
   cursor:text;
   font-size:16px;
   color:#000
}
.contact_form .f-style.active label{
   top:-12px;
   left:15px;
   padding:3px 5px;
   font-size:12px;
   color:#fff;
   background:#000;
   z-index:99
}
.contact_form h2.mheading{
   text-align:left;
   margin-top:0
}
